/* ===== BASE ===== */
QMainWindow, QWidget#centralwidget {
    background: ${app.bg};
    color: ${app.fg};
}

/* ===== STACKED WIDGET & PAGES ===== */
QStackedWidget#stackedWidget,
QWidget#orders_page,
QWidget#daboard_page {
    background: ${stack.bg};
    border: none;
}

/* ===== PAGE FRAMES ===== */
QFrame#daboard_top_frame,
QFrame#daboard_midle_frame_1,
QFrame#daboard_midle_frame_2,
QFrame#daboard_bottom_frame,
QFrame#orders_top_frame,
QFrame#orders_midle_frame_1,
QFrame#orders_midle_frame_2,
QFrame#orders_bottom_frame {
    background: ${frame.bg};
    border: none;
    border-bottom: 1px solid ${border};
    margin: 0;
}

/* ===== SLIDE MENUS ===== */
QFrame#title_frame,
QFrame#left_slide_menu_frame,
QStatusBar#statusbar {
    background: ${slide.bg};
    border: none;
}

QFrame#daboard_midle_frame_1 {
    background: ${frame.bg};
    background-repeat: no-repeat;
    background-position: center;
    border: none;
    margin: 0;
}

/* ===== LABELS ===== */
QLabel#title_label,
QLabel#title_icon,
QLabel#pageTitle {
    background: transparent;
    color: ${app.fg};
    font-family: ${font.family};
}

QLabel#pageTitle { font-size: 20px; }

/* ===== LIST WIDGETS (MENU) ===== */
QListWidget,
QListWidget::viewport,
QListView#listView {
    background: transparent;
    border: none;
    color: ${app.fg};
    font: ${menu.fontSize} ${font.family};
    outline: none;
}

/* --- LOGIC CHỐNG NHẢY ICON (BÙ TRỪ 10PX) --- */

/* 1. TRẠNG THÁI MẶC ĐỊNH (KHÔNG CHỌN) */
QListWidget::item,
QListView#listView::item {
    height: ${menu.itemH};
    margin: 2px 0px; 
    
    /* Border 0 + Padding 10 = Tổng 10px */
    border: none;       
    padding-left: 10px; 
}

/* 2. TRẠNG THÁI ĐANG CHỌN (SELECTED) */
QListWidget::item:selected,
QListView#listView::item:selected {
    background: transparent;  
    color: #3498db;           
    font-weight: bold;

    /* Border 5 + Padding 5 = Tổng 10px */
    border-left: 5px solid #3498db; 
    padding-left: 5px; 
}

/* 3. HIỆU ỨNG HOVER */
QListWidget::item:hover,
QListView#listView::item:hover {
    background: ${hover};
    color: #3498db;
}

/* --- XỬ LÝ KHI MENU THU NHỎ (COLLAPSED) --- */
QListWidget[collapsed="true"] {
    width: ${menu.widthCollapsed};
}

QListWidget[collapsed="true"]::item {
    margin: 0;
    padding: 8px 0;
    border-radius: ${radius};
    text-align: center;
    /* Khi thu nhỏ, ta dùng border trong suốt để giữ chỗ, tránh nhảy khi hover/select */
    border-left: 5px solid transparent; 
    padding-left: 0;
}

QListWidget[collapsed="true"]::item:selected {
    border-left: 5px solid #3498db;
}

QListWidget[collapsed="true"]::item:hover {
    background: ${icon.hover};
    border: 1px solid ${icon.border};
    /* Giữ lại border-left để không bị ghi đè */
    border-left: 5px solid transparent; 
}


/* ===== TOGGLE BUTTONS (OPEN/CLOSE) ===== */

QPushButton#menu_toggle_btn {
    background: transparent;
    border: none;
    color: ${app.fg};
    font-family: ${font.family};
}

/* Nút OPEN (Khi menu đang đóng) */
QPushButton#menu_open_btn {
    background: transparent;
    border: none;
    qproperty-iconSize: 20px 20px;
}

QPushButton#menu_open_btn:hover {
    background: ${hover};
    border-radius: ${radius};
}

/* Nút CLOSE (Khi menu đang mở) - MÀU NHẸ DỊU */
QPushButton#menu_close_btn {
    /* Đỏ rất nhạt (Alpha 0.1) */
    background-color: rgba(231, 76, 60, 0.1); 
    border: 1px solid transparent;
    border-radius: 4px;
    margin: 4px; 
    qproperty-iconSize: 20px 20px;
}

QPushButton#menu_close_btn:hover {
    /* Đậm hơn xíu khi hover */
    background-color: rgba(231, 76, 60, 0.2); 
    border: 1px solid rgba(231, 76, 60, 0.3); 
}

/* ===== TOOLTIP ===== */
QToolTip {
    background-color: #333333;
    color: #ffffff;
    border: 1px solid #555555;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 11px;
}

/* ===== RIGHT PANEL & DASHBOARD ===== */
QFrame#right_slide_menu_frame {
    background: ${slide.bg};
    border-left: 1px solid ${border};
    border-radius: 12px 0 0 12px;
}

QFrame#frame_details {
    background: ${stack.bg};
    border: 1px solid ${border};
    border-radius: 8px;
    padding: 10px;
}

QProgressBar {
    background-color: ${stack.bg};
    border: none;
    border-radius: 4px;
    height: 12px;
}
QProgressBar::chunk {
    border-radius: 4px;
}

QTableView#tableView {
    background: ${stack.bg};
    border: none;
    color: ${app.fg};
    gridline-color: ${border};
}

QTableView#tableView QHeaderView::section {
    background: ${frame.bg};
    color: ${app.fg};
    border: 1px solid ${border};
    padding: 4px;
}