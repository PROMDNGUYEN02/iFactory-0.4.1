/* src\iFactory\resources\themes\base.qss */
/* ===== BASE ===== */
QMainWindow, QWidget#centralwidget {
    background: ${app.bg};
    color: ${app.fg};
}

/* ===== STACKED WIDGET & PAGES ===== */
QStackedWidget#stackedWidget,
QWidget#orders_page,
QWidget#daboard_page {
    background: ${stack.bg};
    border: none;
}

/* ===== PAGE FRAMES ===== */
QFrame#daboard_top_frame,
QFrame#daboard_midle_frame_1,
QFrame#daboard_midle_frame_2,
QFrame#daboard_bottom_frame,
QFrame#orders_top_frame,
QFrame#orders_midle_frame_1,
QFrame#orders_midle_frame_2,
QFrame#orders_bottom_frame {
    background: ${frame.bg};
    border: none;
    border-bottom: 1px solid ${border};
    margin: 0;
}

/* ===== SLIDE MENUS ===== */
QFrame#title_frame,
QFrame#left_slide_menu_frame,
QStatusBar#statusbar {
    background: ${slide.bg};
    border: none;
}

QFrame#daboard_midle_frame_1 {
    background: ${frame.bg};
    background-repeat: no-repeat;
    background-position: center;
    border: none;
    margin: 0;
}

/* ===== LABELS ===== */
QLabel#title_label,
QLabel#title_icon,
QLabel#pageTitle {
    background: transparent;
    color: ${app.fg};
    font-family: ${font.family};
}

QLabel#pageTitle { font-size: 20px; }

/* ===== LIST WIDGETS ===== */
QListWidget,
QListWidget::viewport,
QListView#listView {
    background: transparent;
    border: none;
    color: ${app.fg};
    font: ${menu.fontSize} ${font.family};
    outline: none;
}

QListWidget::item,
QListView#listView::item {
    height: ${menu.itemH};
    border: none;
    padding-left: ${item.padLeft};
    border-radius: 6px;
    margin: 2px 8px; /* Bo góc mượt cho các item menu */
}

QListWidget::item:hover,
QListView#listView::item:hover {
    background: ${hover};
    color: #3498db;
}

QListWidget::item:selected,
QListView#listView::item:selected {
    background: transparent;
}

QListWidget[collapsed="true"] {
    width: ${menu.widthCollapsed};
}

QListWidget[collapsed="true"]::item {
    margin: 0;
    padding: 8px 0;
    border-radius: ${radius};
    text-align: center;
}

QListWidget[collapsed="true"]::item:hover {
    background: ${icon.hover};
    border: 1px solid ${icon.border};
}

/* ===== BUTTONS ===== */
QPushButton#menu_btn,
QPushButton#panelBtn {
    background: transparent;
    border: none;
    color: ${app.fg};
    font-family: ${font.family};
}

QPushButton#menu_btn:hover,
QPushButton#panelBtn:hover {
    background: ${hover};
    border-radius: ${radius};
}

/* ===== RIGHT PANEL & DASHBOARD (NÂNG CẤP MAX LEVEL) ===== */
QFrame#right_slide_menu_frame {
    background: ${slide.bg};
    border-left: 1px solid ${border};
    border-radius: 12px 0 0 12px; /* Bo góc viền trái mượt mà */
}

/* Khung chi tiết bên trong Right Panel */
QFrame#frame_details {
    background: ${stack.bg};
    border: 1px solid ${border};
    border-radius: 8px;
    padding: 10px;
}

/* Tối ưu Progress Bar chuẩn Glassmorphism/Modern Flat */
QProgressBar {
    background-color: ${stack.bg};
    border: none;
    border-radius: 4px;
    height: 12px;
}
QProgressBar::chunk {
    border-radius: 4px;
}

/* ===== TABLE VIEW ===== */
QTableView#tableView {
    background: ${stack.bg};
    border: none;
    color: ${app.fg};
    gridline-color: ${border};
}

QTableView#tableView QHeaderView::section {
    background: ${frame.bg};
    color: ${app.fg};
    border: 1px solid ${border};
    padding: 4px;
}