# File: presentation/resources/themes/base.qss
QMainWindow, QWidget#centralwidget {
    background: ${app.bg};
    color: ${app.fg};
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 13px;
}

QStackedWidget {
    background: ${stack.bg};
    border: none;
}

QFrame#title_frame {
    background: ${slide.bg};
    border: none;
    border-bottom: 1px solid ${border};
    min-height: 48px;
    max-height: 48px;
}

QFrame#left_slide_menu_frame {
    background: ${slide.bg};
    border: none;
    border-right: 1px solid ${border};
}

QFrame#left_slide_menu_frame QListWidget {
    background: transparent;
    border: none;
}

QFrame#right_slide_menu_frame {
    background: ${slide.bg};
    border: none;
    border-left: 1px solid ${border};
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 4px 2px;
}

QScrollBar::handle:vertical {
    background: ${hint};
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: ${app.fg};
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
    height: 0;
}

QPushButton {
    background-color: ${hover};
    border: 1px solid ${border};
    border-radius: 8px;
    padding: 8px 16px;
    color: ${app.fg};
    font-weight: 500;
}

QPushButton:hover {
    background-color: ${selected};
}

QLabel {
    color: ${app.fg};
    background: transparent;
}

QFrame#frame_details {
    background-color: ${frame.bg};
    border: 1px solid ${border};
    border-radius: 10px;
    padding: 12px;
}

QProgressBar {
    background-color: ${hover};
    border: none;
    border-radius: 4px;
    height: 6px;
}

QProgressBar::chunk {
    background-color: ${accent};
    border-radius: 4px;
}

QStatusBar {
    background-color: ${slide.bg};
    border-top: 1px solid ${border};
    color: ${hint};
    font-size: 11px;
    min-height: 26px;
}

QStatusBar::item {
    border: none;
}

QLCDNumber {
    background: transparent;
    color: ${app.fg};
    border: none;
}

QToolTip {
    background-color: ${tooltip.bg};
    color: ${tooltip.text};
    border: 1px solid ${tooltip.border};
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

QFrame#daboard_top_frame,
QFrame#orders_top_frame {
    background-color: ${frame.bg};
    border: none;
    border-bottom: 1px solid ${border};
}

QFrame#daboard_bottom_frame,
QFrame#orders_bottom_frame {
    background-color: ${frame.bg};
    border: none;
    border-top: 1px solid ${border};
}