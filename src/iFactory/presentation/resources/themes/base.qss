/* GLOBAL RESET */
QMainWindow, QWidget#centralwidget { background: ${app.bg}; color: ${app.fg}; font-family: "Segoe UI", sans-serif; }
QStackedWidget { background: ${stack.bg}; border: none; }

/* PANEL BORDERS */
QFrame#title_frame, QFrame#left_slide_menu_frame {
    background: ${slide.bg};
    border: none;
    border-right: 1px solid ${border};
}
QFrame#title_frame { border-bottom: 1px solid ${border}; }

/* HEADER BUTTONS */
QPushButton#menu_toggle_btn, 
QPushButton#minimize_window_button, 
QPushButton#restore_window_button, 
QPushButton#close_window_button {
    background: transparent;
    border: none;
    border-radius: 6px;
    margin: 2px;
    color: ${app.fg};
    text-align: center;
}

QPushButton#menu_toggle_btn:hover, 
QPushButton#minimize_window_button:hover, 
QPushButton#restore_window_button:hover {
    background-color: ${hover};
}
QPushButton#close_window_button:hover { background-color: #E81123; color: white; }

/* SIDEBAR LIST */
QListWidget {
    background: transparent;
    border: none;
    outline: none;
    margin-top: 10px;
}

/* EXPANDED STATE (Có chữ, Icon trái) */
QListWidget::item {
    height: 42px;
    margin: 2px 8px; /* Khoảng cách giữa các item */
    border-radius: 6px;
    padding-left: 12px;
    color: ${app.fg};
    font-size: 14px;
    border: 1px solid transparent;
}

/* COLLAPSED STATE (Không chữ, Icon giữa) */
QListWidget[collapsed="true"] { width: ${menu.widthCollapsed}; }

QListWidget[collapsed="true"]::item {
    /* [QUAN TRỌNG] Reset padding để text-align hoạt động */
    padding: 0px; 
    margin: 4px 5px; /* Căn giữa box 50x42 */
    text-align: center; /* Icon vào giữa */
    
    /* Ẩn Text bằng font size ảo */
    color: transparent;
    font-size: 1px;
}

/* HOVER & SELECTED */
QListWidget::item:hover {
    background-color: ${hover};
    border: 1px solid ${border};
}

QListWidget::item:selected {
    background-color: ${selected};
    color: ${selected.text};
    font-weight: 600;
}

QListWidget[collapsed="true"]::item:selected {
    color: transparent; /* Đảm bảo không hiện text màu xanh khi chọn */
}

/* SETTINGS BOTTOM */
QListWidget#listWidget_settings {
    margin-bottom: 10px;
    border-top: 1px solid ${border};
    padding-top: 5px;
}